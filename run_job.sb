#!/bin/bash --login
#SBATCH --job-name=nlp_cpu_job    # Job name
#SBATCH --output=job_output.log   # Standard output log
#SBATCH --error=job_error.log     # Standard error log
#SBATCH --time=01:00:00           # Time limit (hh:mm:ss)
#SBATCH --nodes=1                 # Number of nodes
#SBATCH --ntasks=1                # Number of tasks
#SBATCH --cpus-per-task=8         # Number of CPUs to use (adjust as needed)
#SBATCH --mem=32G                  # Memory per node (adjust as needed)

PROJECT_DIR="/mnt/home/madired3/CSE 842 - NLP"
CONDA_ENV_NAME="myenv"
PYTHON_SCRIPT="draft2.py"

module purge
cd "$PROJECT_DIR"

eval "$(conda shell.bash hook)"
conda activate $CONDA_ENV_NAME

echo "Executing Python script: $PYTHON_SCRIPT"
python $PYTHON_SCRIPT
